{
  "manifest_version": 3,
  "name": "TechSteps Screen Assist",
  "version": "0.1.0",
  "description": "Draws TechSteps' pointer directly on the page you're being helped with.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["https://tech-steps.org/*", "http://localhost/*"]
  },
  "action": {
    "default_title": "TechSteps Screen Assist"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}
